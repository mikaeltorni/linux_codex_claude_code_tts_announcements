#!/usr/bin/env python3
"""Reapply enabled TTS hooks without a build, download, or interactive prompt."""

from pathlib import Path
import shlex
import sys

_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_ROOT / 'lib'))
if __name__ == '__main__':
    if len(sys.argv) > 1:
        print('Usage: tts-reconcile (reapply enabled hooks with saved voices)')
        raise SystemExit(0 if sys.argv[1:] in (['--help'], ['-h']) else 2)
    if not (Path.home() / '.config/agent-tts/harness-hooks.enabled').is_file():
        raise SystemExit(0)
    from tts_announcements.installation import main
    program = _ROOT / 'scripts/notify-agent'
    command = shlex.quote(str(program)) if program.is_file() else 'python3 ' + shlex.quote(str(_ROOT / 'scripts/notify_agent.py'))
    raise SystemExit(main(['--home', str(Path.home()), '--command', command,
                          '--sync', '--require-enabled']))
