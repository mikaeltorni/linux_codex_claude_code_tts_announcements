#!/usr/bin/env python3
"""Entry point for the Agent TTS (ATTS) speech engine.

Resolves the bundled ``agent_tts`` package relative to this script — whether run
from a source checkout (``<repo>/scripts/agent-tts`` with the package in
``<repo>/lib``) or from the installed layout (``<root>/scripts/agent-tts`` with
the package in ``<root>/lib``) — then dispatches to its CLI.
"""

import sys
from pathlib import Path

_LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
if str(_LIB_DIR) not in sys.path:
    sys.path.insert(0, str(_LIB_DIR))

from agent_tts.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
